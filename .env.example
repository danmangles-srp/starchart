# Cadence — environment template. Copy to .env (gitignored) and fill real values locally;
# in deploy, set these in Vercel project settings. NEVER commit real secrets.

# PostgreSQL (single source of truth)
DATABASE_URL=postgresql://user:password@localhost:5432/cadence
# Separate database for the data-access (Tier 2.5) tests — never the dev/prod DB.
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/cadence_test

# Auth.js (NextAuth v5) — generate with: openssl rand -base64 33
AUTH_SECRET=replace-me

# Google OAuth client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID app registration
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# Sign-in allowlist — comma-separated Google Workspace / Entra domains, checked server-side
ALLOWED_EMAIL_DOMAINS=example.com
